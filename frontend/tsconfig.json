{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "build/types",
    "lib": [
      "DOM",
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}

